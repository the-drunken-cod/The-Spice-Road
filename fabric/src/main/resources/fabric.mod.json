{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/#REPLACE_REPO",
        "sources": "https://github.com/#REPLACE_REPO"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.drunkencod.spice_road.SpiceRoadMod"
        ],
        "client": [
            "com.drunkencod.spice_road.client.SpiceRoadClientMod"
        ],
        "fabric-datagen": [
            "com.drunkencod.spice_road.ModDataGen"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json",
        "${mod_id}.compat.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "cookingforblockheads": ">=${cooking_for_blockheads_min_version}"
    },
    "breaks": {
        "cookingforblockheads": "<${cooking_for_blockheads_min_version}"
    }
}
